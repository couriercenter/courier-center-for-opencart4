{# Courier Center tab of the admin order page. Values arrive decoded from the controller and are escaped here; the script moves it into a tab. #}
<div id="cc-order-panel-raw" style="display:none">
<div id="cc-panel" style="max-width:600px;">
  <style>
    #cc-panel .cc-info-box { background:#e7f5e9; border-left:4px solid #46b450; padding:12px; border-radius:3px; margin-bottom:10px; }
    #cc-panel .cc-info-box table { width:100%; font-size:13px; }
    #cc-panel .cc-info-box td { padding:3px 0; vertical-align:top; }
    #cc-panel .cc-info-box td:first-child { color:#555; width:140px; }
    #cc-panel .cc-voided { background:#fce8e6; border-left:4px solid #dc3232; padding:12px; border-radius:3px; margin-bottom:10px; }
    #cc-panel .cc-status { padding:8px 10px; border-left:4px solid #2271b1; background:#f0f6fc; border-radius:3px; margin:8px 0; font-size:12px; }
    #cc-panel .cc-status.cc-delivered { background:#e7f5e9; border-left-color:#46b450; }
    #cc-panel .cc-status.cc-failed { background:#fff3cd; border-left-color:#dba617; }
    #cc-panel .cc-status.cc-returned { background:#fce8e6; border-left-color:#dc3232; }
    #cc-panel .cc-return-awb { margin-top:8px; padding:8px; border-top:1px dashed #b8d4b8; font-size:12px; }
    #cc-panel .cc-locker-box { background:#f0faf2; border:1px solid #7bc47f; border-radius:3px; padding:8px 10px; margin:8px 0; font-size:12px; }
    #cc-panel .cc-form-section { border:1px solid #ddd; border-radius:4px; padding:10px; margin:8px 0; background:#f9f9f9; }
    #cc-panel .cc-form-section > .cc-label { font-weight:600; display:block; margin-bottom:6px; font-size:13px; }
    #cc-panel .cc-row { display:block; padding:5px 4px; border-radius:3px; cursor:pointer; font-size:13px; font-weight:normal; }
    #cc-panel .cc-row small { color:#666; display:block; margin-left:20px; }
  </style>

  {% if has_active %}
    <div class="cc-info-box">
      <strong>✅ Voucher Δημιουργήθηκε</strong>
      <table style="margin-top:6px;">
        <tr><td>AWB:</td><td><strong>{{ shipment.voucher_number|e }}</strong></td></tr>
        {% if shipment.tracking_number and shipment.tracking_number != shipment.voucher_number %}<tr><td>Tracking:</td><td>{{ shipment.tracking_number|e }}</td></tr>{% endif %}
        <tr><td>Υπηρεσία:</td><td>{{ service_label|e }}</td></tr>
        {% if point_info %}<tr><td>Σημείο:</td><td>📍 {{ point_info|e }}</td></tr>{% endif %}
        {% if shipment.boxnow_parcel_id %}<tr><td>BOX NOW Parcel ID:</td><td><strong>{{ shipment.boxnow_parcel_id|e }}</strong></td></tr>{% endif %}
      </table>
      {% if shipment.is_boxnow == '1' %}
      <div class="cc-locker-box">
        <strong>📦 BOX NOW Locker</strong><br>
        {% if shipment.locker_name %}<span>{{ shipment.locker_name|e }}</span><br>{% endif %}
        {% if shipment.locker_id %}<small style="color:#888;">ID: {{ shipment.locker_id|e }}</small>{% endif %}
      </div>
      {% endif %}
      {% if shipment.return_awb %}
      <div class="cc-return-awb"><strong>↩️ Επιστροφικό ({{ return_label|e }})</strong><br>Return AWB: <strong>{{ shipment.return_awb|e }}</strong></div>
      {% endif %}
    </div>
    {% if shipment.status_desc %}
    <div class="cc-status {{ status_class|e }}">
      <strong>📍 {{ shipment.status_desc|e }}</strong>
      {% if shipment.status_updated_at %}<br><small>Τελ. ενημέρωση: {{ shipment.status_updated_at|e }}</small>{% endif %}
    </div>
    {% endif %}
    <div class="d-flex flex-wrap gap-2 mt-2">
      <a href="{{ url_download|e }}" class="btn btn-success btn-sm" target="_blank"><i class="fa-solid fa-print"></i> Εκτύπωση Voucher (PDF)</a>
      {% if shipment.return_awb %}<a href="{{ url_download_return|e }}" class="btn btn-secondary btn-sm" target="_blank"><i class="fa-solid fa-rotate-left"></i> Επιστροφικό (PDF)</a>{% endif %}
      <button type="button" class="btn btn-info btn-sm" data-cc-action="status"><i class="fa-solid fa-rotate"></i> Ανανέωση</button>
      <button type="button" class="btn btn-danger btn-sm" data-cc-action="void"><i class="fa-solid fa-xmark"></i> Ακύρωση</button>
    </div>
  {% else %}
    {% if was_voided %}
    <div class="cc-voided"><strong>❌ Αποστολή Ακυρωμένη</strong><br><span style="font-size:13px;">AWB: <del>{{ shipment.voucher_number|e }}</del></span></div>
    <p style="font-size:12px; color:#666;">Μπορείς να δημιουργήσεις νέο voucher.</p>
    {% endif %}
    {% if consignee %}<p style="font-size:12px; color:#555;">👤 Παραλήπτης: {{ consignee|e }}</p>{% endif %}
    {% if has_points %}
    <div class="cc-form-section">
      <span class="cc-label">📍 Σημείο αποστολής:</span>
      <select id="cc-pickup-point" class="form-select form-select-sm">
        {% for pt in point_options %}<option value="{{ pt.code|e }}"{% if pt.code == selected_point %} selected{% endif %}>{{ pt.label|e }}</option>{% endfor %}
      </select>
    </div>
    {% endif %}
    {% if locker_id and delivery_mode == 'pick' %}
    <div class="cc-locker-box" style="font-size:13px;">
      <strong>📦 BOX NOW Locker (επιλεγμένο από πελάτη)</strong><br>
      <span style="color:#2c6e35;">{{ locker_name ? locker_name|e : locker_id|e }}</span><br>
      <small style="color:#888;">ID: {{ locker_id|e }}</small>
    </div>
    <button type="button" class="btn btn-primary btn-sm w-100 mb-2" data-cc-action="create-boxnow" data-locker-id="{{ locker_id|e }}" data-locker-code="{{ locker_code|e }}" data-locker-name="{{ locker_name|e }}"><i class="fa-solid fa-plus"></i> Δημιουργία BOX NOW Voucher</button>
    <button type="button" class="btn btn-warning btn-sm w-100" data-cc-action="remove-boxnow">↩️ Αφαίρεση BOX NOW</button>
    {% elseif delivery_mode == 'auto' %}
    <div class="cc-locker-box" style="background:#fff8e1; border-color:#ffc107;">
      <strong>📦 BOX NOW — Αυτόματη εύρεση Locker</strong><br>
      <span style="font-size:12px; color:#7a6000;">Κοντινότερο διαθέσιμο BOX NOW Locker</span>
    </div>
    <button type="button" class="btn btn-primary btn-sm w-100 mb-2" data-cc-action="create-boxnow" data-locker-id="" data-locker-code="" data-locker-name=""><i class="fa-solid fa-plus"></i> Δημιουργία BOX NOW Voucher</button>
    <button type="button" class="btn btn-warning btn-sm w-100" data-cc-action="remove-boxnow">↩️ Αφαίρεση BOX NOW</button>
    {% else %}
    <p style="margin-bottom:10px; font-size:13px;">Δημιούργησε voucher για αυτή την παραγγελία:</p>
    <div class="cc-form-section">
      <span class="cc-label">📦 Υπηρεσία:</span>
      <select id="cc-service-type" class="form-select form-select-sm">
        <option value="next_day">Επόμενη Μέρα</option>
        <option value="same_day_3h">Αυθημερόν 3 ώρες</option>
        <option value="same_day_5h">Αυθημερόν 5 ώρες</option>
      </select>
    </div>
    <div class="cc-form-section">
      <span class="cc-label">📦 Πολλαπλά τεμάχια:</span>
      <label class="cc-row"><input type="checkbox" id="cc-multi-parcel"> Ενεργοποίηση πολλαπλών τεμαχίων</label>
      <div id="cc-parcel-wrap" style="display:none; margin-top:8px;">Αριθμός τεμαχίων: <input type="number" id="cc-parcel-count" value="2" min="2" max="99" class="form-control form-control-sm d-inline-block" style="width:80px;"></div>
    </div>
    <div class="cc-form-section">
      <span class="cc-label">↩️ Επιστροφικό:</span>
      <label class="cc-row"><input type="radio" name="cc-return" value="none" checked> Χωρίς επιστροφικό</label>
      <label class="cc-row"><input type="radio" name="cc-return" value="optional"> <strong>Προαιρετικό</strong><small>Ο παραλήπτης μπορεί να το ενεργοποιήσει αργότερα</small></label>
      <label class="cc-row"><input type="radio" name="cc-return" value="mandatory"> <strong>Υποχρεωτικό</strong><small>Ο courier παραλαμβάνει επιστροφικό κατά την παράδοση</small></label>
    </div>
    <div class="cc-form-section">
      <label class="cc-row"><input type="checkbox" id="cc-boxnow"> <strong>📦 BOX NOW Locker</strong><small>Αυτόματη αναζήτηση σε ακτίνα 1.5km</small></label>
    </div>
    <button type="button" class="btn btn-primary btn-sm w-100" data-cc-action="create"><i class="fa-solid fa-plus"></i> Δημιουργία Voucher</button>
    {% endif %}
  {% endif %}
  <div class="cc-msg mt-2"></div>

  {% if returns or can_add_return or return_notice %}
  <hr>
  <h5>↩️ Επιστροφές</h5>
  {% if return_notice %}<div class="alert alert-{{ (return_notice.type == 'success' ? 'success' : 'warning')|e }}" id="cc-return-notice">{{ return_notice.text|e }}</div>{% endif %}
  <div id="cc-ret-msg"></div>
  {% if not returns %}<p class="text-muted">Δεν υπάρχουν επιστροφές για αυτή την παραγγελία.</p>{% endif %}
  {% for r in returns %}
  <div class="cc-form-section" data-id="{{ r.id|e }}">
    <strong>#{{ r.id|e }} — {{ r.status_label|e }}</strong> <small class="text-muted">{{ r.created_at|e }} · Από: {{ (r.from_shop ? 'Κατάστημα' : 'Πελάτης')|e }}</small><br>
    <small>{{ r.method_label|e }}{% if r.locker_label %} · Θυρίδα: {{ r.locker_label|e }}{% endif %} · {{ r.items|e }}</small>
    {% if r.pickup_label %}<br><small>Παραλαβή: <strong>{{ r.pickup_label|e }}</strong> · {{ r.pickup_address|e }}{% if r.courier_notes %} · «{{ r.courier_notes|e }}»{% endif %}</small>{% endif %}
    {% if r.reason %}<br><small class="text-muted">«{{ r.reason|e }}»</small>{% endif %}
    {% if r.return_awb %}<br><small>AWB επιστροφής: <strong>{{ r.return_awb|e }}</strong>{% if r.rsn %} · Κωδικός BOX NOW: <strong>{{ r.rsn|e }}</strong>{% endif %}{% if r.tracking %} · 📍 {{ r.tracking|e }}{% endif %}</small>{% endif %}
    {% if r.last_error %}<br><small class="text-danger">{{ r.last_error|e }}</small>{% endif %}
    <div class="mt-1 d-flex flex-wrap gap-1">
      {% if r.can_approve %}<button type="button" class="btn btn-success btn-sm" data-cc-ret="approve"><i class="fa-solid fa-check"></i> Έγκριση</button>{% endif %}
      {% if r.can_create %}<button type="button" class="btn btn-primary btn-sm" data-cc-ret="create"><i class="fa-solid fa-truck"></i> Δημιουργία αποστολής</button>{% endif %}
      {% if r.can_verify %}<button type="button" class="btn btn-warning btn-sm" data-cc-ret="verify"><i class="fa-solid fa-magnifying-glass"></i> Έλεγχος ύπαρξης αποστολής</button>{% endif %}
      {% if r.can_track %}<button type="button" class="btn btn-info btn-sm" data-cc-ret="track"><i class="fa-solid fa-rotate"></i> Tracking</button>{% endif %}
      {% if r.can_reject %}<button type="button" class="btn btn-danger btn-sm" data-cc-ret="reject"><i class="fa-solid fa-xmark"></i> Απόρριψη</button>{% endif %}
      {% if r.print_url %}<a href="{{ r.print_url|e }}" target="_blank" class="btn btn-light btn-sm"><i class="fa-solid fa-print"></i> Voucher επιστροφής</a>{% endif %}
    </div>
  </div>
  {% endfor %}
  {% if can_add_return %}<a href="{{ url_add_return|e }}" class="btn btn-light btn-sm" id="cc-add-return"><i class="fa-solid fa-plus"></i> Νέα επιστροφή</a>{% endif %}
  {% endif %}
</div>
</div>
{{ returns_js }}
<script>
(function () {
  var ORDER_ID = {{ order_id|json_encode }};
  var URLS = {{ urls|json_encode }};
  var EXPIRED = 'Η σύνδεση έληξε ή ο server απάντησε με σφάλμα. Κάνε ανανέωση της σελίδας (F5) και ξαναδοκίμασε.';

  function place() {
    var raw = document.getElementById('cc-order-panel-raw');
    if (!raw) return null;
    var panel = raw.querySelector('#cc-panel');
    var navTabs = document.querySelector('#content ul.nav-tabs');
    var tabContent = navTabs ? navTabs.parentNode.querySelector('.tab-content') : null;
    if (!navTabs || !tabContent) { raw.style.display = ''; return panel; }
    var li = document.createElement('li'); li.className = 'nav-item';
    var a = document.createElement('a'); a.href = '#tab-courier-center'; a.setAttribute('data-bs-toggle', 'tab'); a.className = 'nav-link';
    a.innerHTML = '<i class="fa-solid fa-truck"></i> Courier Center';
    li.appendChild(a); navTabs.appendChild(li);
    var pane = document.createElement('div'); pane.id = 'tab-courier-center'; pane.className = 'tab-pane'; pane.style.padding = '15px 0';
    pane.appendChild(panel); tabContent.appendChild(pane);
    raw.parentNode.removeChild(raw);
    if (window.location.hash === '#cc-tab' && window.bootstrap) { new bootstrap.Tab(a).show(); }
    return panel;
  }

  function init() {
    var panel = place();
    if (!panel) return;
    function msg(type, text) {
      var box = panel.querySelector('.cc-msg'); box.innerHTML = '';
      var d = document.createElement('div'); d.className = 'alert alert-' + type; d.textContent = text; box.appendChild(d);
    }
    function post(url, params, done) {
      params.order_id = ORDER_ID;
      fetch(url, {method: 'POST', credentials: 'same-origin', headers: {'Content-Type': 'application/x-www-form-urlencoded'}, body: new URLSearchParams(params).toString()})
        .then(function (r) { return r.text(); })
        .then(function (t) { var j = null; try { j = JSON.parse(t); } catch (e) {} if (!j) { msg('danger', EXPIRED); return; } done(j); })
        .catch(function (e) { msg('danger', String(e)); });
    }
    function reload() { window.location.hash = 'cc-tab'; window.location.reload(); }
    function create(params) {
      var pp = panel.querySelector('#cc-pickup-point');
      if (pp) { params.pickup_point = pp.value; }
      post(URLS.create, params, function (r) {
        if (r.success) { reload(); return; }
        if (r.needs_override) { if (confirm(r.error)) { params.override = 1; create(params); } return; }
        msg('danger', r.error || 'Σφάλμα δημιουργίας voucher');
      });
    }
    panel.addEventListener('click', function (e) {
      var b = e.target.closest ? e.target.closest('[data-cc-action]') : null;
      if (!b) return;
      var action = b.getAttribute('data-cc-action');
      if (action === 'create') {
        var multi = panel.querySelector('#cc-multi-parcel'), ret = panel.querySelector('input[name="cc-return"]:checked');
        create({service_type: panel.querySelector('#cc-service-type').value,
          parcel_count: multi && multi.checked ? parseInt(panel.querySelector('#cc-parcel-count').value || '2', 10) : 1,
          return_option: ret ? ret.value : 'none', boxnow: panel.querySelector('#cc-boxnow').checked ? 1 : 0});
      } else if (action === 'create-boxnow') {
        create({service_type: 'next_day', boxnow: 1, return_option: 'none', parcel_count: 1,
          locker_id: b.getAttribute('data-locker-id'), locker_code: b.getAttribute('data-locker-code'), locker_name: b.getAttribute('data-locker-name')});
      } else if (action === 'void') {
        if (confirm('Ακύρωση αποστολής;')) post(URLS.void, {}, function (r) { if (r.success) { reload(); } else { msg('danger', r.error || 'Σφάλμα ακύρωσης'); } });
      } else if (action === 'status') {
        post(URLS.status, {}, function (r) { if (r.success) { reload(); } else { msg('danger', r.error || 'Σφάλμα ανανέωσης'); } });
      } else if (action === 'remove-boxnow') {
        if (confirm('Αφαίρεση BOX NOW από αυτή την παραγγελία;')) post(URLS.removeBoxnow, {}, function (r) { if (r.success) { reload(); } else { msg('danger', r.error || 'Σφάλμα αφαίρεσης BOX NOW'); } });
      }
    });
    var multi = panel.querySelector('#cc-multi-parcel');
    if (multi) multi.addEventListener('change', function () { panel.querySelector('#cc-parcel-wrap').style.display = this.checked ? '' : 'none'; });
  }
  if (document.readyState === 'loading') { document.addEventListener('DOMContentLoaded', init); } else { init(); }
})();
</script>
